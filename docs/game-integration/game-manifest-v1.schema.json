{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://play.longern.com/schemas/game-manifest-v1.json",
  "title": "Playweft Game Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "manifest_version",
    "id",
    "version",
    "protocol",
    "start_url",
    "name"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "start_url": {
      "$ref": "#/$defs/resourceUrl"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "name_localized": {
      "$ref": "#/$defs/localizedNames"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description_localized": {
      "$ref": "#/$defs/localizedDescriptions"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/icon"
      }
    },
    "background_color": {
      "$ref": "#/$defs/color"
    },
    "theme_color": {
      "$ref": "#/$defs/color"
    },
    "orientation": {
      "enum": [
        "any",
        "natural",
        "portrait",
        "portrait-primary",
        "portrait-secondary",
        "landscape",
        "landscape-primary",
        "landscape-secondary"
      ]
    },
    "help_url": {
      "$ref": "#/$defs/resourceUrl"
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "solo": {
          "type": "object",
          "additionalProperties": false
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "players",
            "server"
          ],
          "properties": {
            "players": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              }
            },
            "server": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime",
                "entry",
                "persistence"
              ],
              "properties": {
                "runtime": {
                  "const": "lua"
                },
                "entry": {
                  "$ref": "#/$defs/resourceUrl"
                },
                "persistence": {
                  "enum": [
                    "durable",
                    "live"
                  ]
                }
              }
            },
            "lobby": {
              "enum": [
                "platform",
                "game"
              ],
              "default": "platform",
              "description": "Use the platform lobby, or let this game render its own lobby."
            }
          }
        }
      }
    },
    "launch_mode": {
      "type": "string",
      "enum": [
        "auto",
        "solo",
        "choose"
      ],
      "default": "auto",
      "description": "Omission or auto opens directly; choose prompts for games supporting both modes. solo remains a compatibility alias."
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server"
      ],
      "properties": {
        "server": {
          "$ref": "#/properties/modes/properties/room/properties/server"
        }
      },
      "description": "Optional default for rooms.create(). Games may instead pass server at creation and omit this member."
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "localizedNames": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/locale"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localizedName"
      }
    },
    "localizedDescriptions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/locale"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localizedDescription"
      }
    },
    "localizedName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "$ref": "#/$defs/localizedNameObject"
        }
      ]
    },
    "localizedDescription": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "$ref": "#/$defs/localizedDescriptionObject"
        }
      ]
    },
    "localizedNameObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dir": {
          "enum": [
            "auto",
            "ltr",
            "rtl"
          ]
        },
        "lang": {
          "$ref": "#/$defs/locale"
        }
      }
    },
    "localizedDescriptionObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "dir": {
          "enum": [
            "auto",
            "ltr",
            "rtl"
          ]
        },
        "lang": {
          "$ref": "#/$defs/locale"
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src"
      ],
      "properties": {
        "src": {
          "$ref": "#/$defs/resourceUrl"
        },
        "sizes": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:any|[1-9][0-9]*x[1-9][0-9]*)(?: (?:any|[1-9][0-9]*x[1-9][0-9]*))*$"
        },
        "type": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^image/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "purpose": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?:any|maskable|monochrome)(?: (?:any|maskable|monochrome))*$"
        }
      }
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resourceUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "launch_mode"
        ],
        "properties": {
          "launch_mode": {
            "const": "solo"
          }
        }
      },
      "then": {
        "properties": {
          "modes": {
            "required": [
              "solo"
            ]
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "room",
          "modes"
        ],
        "properties": {
          "modes": {
            "required": [
              "room"
            ]
          }
        }
      }
    }
  ]
}
